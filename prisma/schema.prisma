// Prisma schema for real estate landing page system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminDomainRole {
  admin
  executive
  member
  explorer
}

model ClientTenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domains   Domain[]
  roles     TenantRole[]
  members   TenantMembership[]
}

model TenantRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  builtInKey  String?
  isBuiltIn   Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allDomainsMembers TenantMembership[] @relation("AllDomainsRole")
  domainAccess      TenantUserDomainAccess[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model TenantMembership {
  id               String   @id @default(uuid())
  tenantId         String
  userId           String
  allDomainsRoleId String?
  isTenantAdmin    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             AdminUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  allDomainsRole   TenantRole?  @relation("AllDomainsRole", fields: [allDomainsRoleId], references: [id], onDelete: SetNull)
  domainAccess     TenantUserDomainAccess[]

  @@unique([tenantId, userId])
  @@index([userId])
}

model TenantUserDomainAccess {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  domainId  String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  domain     Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  role       TenantRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, domainId])
  @@index([tenantId])
  @@index([domainId])
}

model AdminUser {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String
  name            String
  role            String            @default("admin")
  isPlatformAdmin Boolean           @default(false)
  allDomainsRole  AdminDomainRole?
  createdById     String?
  createdBy       AdminUser?        @relation("AdminUserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers    AdminUser[]       @relation("AdminUserCreatedBy")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  domainAccess    AdminUserDomainAccess[]
  tenantMemberships TenantMembership[]
}

model AdminUserDomainAccess {
  id        String          @id @default(uuid())
  userId    String
  domainId  String
  role      AdminDomainRole
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      AdminUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain    Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, domainId])
  @@index([domainId])
}

model Domain {
  id                      String   @id @default(uuid())
  tenantId                String
  hostname                String
  displayName             String
  logoUrl                 String?
  faviconUrl              String?
  primaryColor            String   @default("#1a365d")
  accentColor             String   @default("#c6952b")
  agentName               String?
  agentPhoto              String?
  agentPhone              String?
  complianceText          String?
  ga4Id                   String?
  metaPixelId             String?
  notifyEmail             String
  notifySms               String?
  defaultBuyerFormSchema  Json?
  defaultSellerFormSchema Json?
  isActive                Boolean  @default(true)
  linkedinUrl             String?
  linkedinVisible         Boolean  @default(true)
  googleUrl               String?
  googleVisible           Boolean  @default(true)
  facebookUrl             String?
  facebookVisible         Boolean  @default(true)
  instagramUrl            String?
  instagramVisible        Boolean  @default(true)
  zillowUrl               String?
  zillowVisible           Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  ClientTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pages                   LandingPage[]
  defaultHomepagePageId   String?
  defaultHomepageButtonLimit Int @default(9)
  defaultHomepageButtons  Json?
  defaultHomepagePage     LandingPage? @relation("DomainDefaultHomepage", fields: [defaultHomepagePageId], references: [id], onDelete: SetNull)
  leads                   Lead[]
  adminAccess             AdminUserDomainAccess[]
  tenantUserAccess        TenantUserDomainAccess[]

  @@unique([tenantId, hostname])
  @@index([tenantId])
}

model MasterTemplate {
  id          String   @id @default(uuid())
  type        String   @unique
  name        String
  sections    Json
  formSchema  Json
  isLocked    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pages       LandingPage[]
}

model LandingPage {
  id               String   @id @default(uuid())
  slug             String
  domainId         String
  domain           Domain        @relation(fields: [domainId], references: [id])
  masterTemplateId String
  masterTemplate   MasterTemplate @relation(fields: [masterTemplateId], references: [id])
  type             String
  status           String   @default("draft")
  deletedAt        DateTime?
  deletedBy        String?
  archivedSlug     String?
  bookmarked       Boolean  @default(false)
  adminListOrder   Int      @default(0)
  title          String?
  headline       String
  subheadline    String?
  heroImageUrl   String?
  sections       Json
  ctaText        String   @default("Get Access")
  successMessage String   @default("Thank you!")
  deliverableUrl String?
  footerHtml     String?
  notes          String?
  useCustomForm Boolean @default(false)
  formSchema    Json?
  multistepStepSlugs Json?
  multistepNotifyEachStep Boolean @default(false)
  primaryColor String?
  accentColor  String?
  seoTitle       String?
  seoDescription String?
  seoKeywords    Json?
  ogImageUrl     String?
  ogType         String?  @default("website")
  twitterCard    String?  @default("summary_large_image")
  canonicalUrl   String?
  noIndex        Boolean  @default(false)
  schemaMarkup   Json?
  customHeadTags Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
  pageLayout PageLayout?
  defaultHomepageForDomains Domain[] @relation("DomainDefaultHomepage")

  @@unique([domainId, slug])
}

model PageLayout {
  id        String   @id @default(uuid())
  pageId    String   @unique
  page      LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  layoutData Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String   @id @default(uuid())
  domainId    String
  domain      Domain      @relation(fields: [domainId], references: [id])
  pageId      String
  page        LandingPage @relation(fields: [pageId], references: [id])
  type        String
  formData    Json
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookConfig {
  id        String   @id @default(uuid())
  name      String
  url       String
  method    String   @default("POST")
  headers   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUiSettings {
  id               String   @id @default("singleton")
  toastSuccessBg    String   @default("#ecfdf3")
  toastSuccessText  String   @default("#166534")
  toastErrorBg      String   @default("#fef2f2")
  toastErrorText    String   @default("#b91c1c")
  toastAlertBg      String   @default("#fffbeb")
  toastAlertText    String   @default("#92400e")
  toastInfoBg       String   @default("#eff6ff")
  toastInfoText     String   @default("#1d4ed8")
  toastIconSize     Int      @default(24)
  toastSuccessTitle String   @default("Success")
  toastSuccessBody  String   @default("Action completed successfully.")
  toastErrorTitle   String   @default("Something went wrong")
  toastErrorBody    String   @default("Please try again.")
  toastAlertTitle   String   @default("Attention")
  toastAlertBody    String   @default("Please review this information.")
  editorFonts       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
